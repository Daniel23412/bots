# Optional Telegram webhook secret token.
# BOT_TOKEN is only needed locally when running scripts/set-telegram-webhook.mjs;
# it is not required by the deployed webhook route.
TELEGRAM_WEBHOOK_SECRET=
# Optional PostgreSQL connection string. App works without DB; history then stays client-side.
DATABASE_URL=
# Protects admin API. Use a long random value.
ADMIN_SECRET=
# Default signal cooldown in seconds.
SIGNAL_COOLDOWN_SECONDS=5
